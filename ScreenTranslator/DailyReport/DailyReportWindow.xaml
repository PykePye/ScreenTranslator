<Window x:Class="ScreenTranslator.DailyReport.DailyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTranslator.DailyReport"
        Title="Daily Report" Height="660" Width="740"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7" MinWidth="560" MinHeight="480">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Entries -->
            <RowDefinition Height="Auto"/>  <!-- Templates -->
            <RowDefinition Height="Auto"/>  <!-- Input -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <DatePicker x:Name="DayPicker" Width="130" VerticalAlignment="Center"/>
                <TextBlock x:Name="WeekLabelText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#6E6E73" FontStyle="Italic"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ImportBtn" Content="Import mẫu…" Padding="10,4" Margin="0,0,6,0" Click="ImportBtn_Click"/>
                <Button x:Name="ExportBtn" Content="Xuất tuần (.xlsx)" Padding="10,4" FontWeight="SemiBold" Click="ExportBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Entries -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1">
            <ScrollViewer x:Name="EntriesScroll" VerticalScrollBarVisibility="Auto" Margin="6">
                <ItemsControl x:Name="EntriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="10" CornerRadius="8"
                                    Background="#FBFBFD" BorderBrush="#E5E5EA" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- No + lock badge -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding No}" FontWeight="Bold" FontSize="16"
                                                   Foreground="#1C1C1E" HorizontalAlignment="Center"/>
                                        <TextBlock Text="🔒" FontSize="10" HorizontalAlignment="Center"
                                                   ToolTip="Việc cố định"
                                                   Visibility="{Binding IsFixed, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <!-- Vietnamese original -->
                                        <TextBlock Text="{Binding ViText}" TextWrapping="Wrap"
                                                   Foreground="#8E8E93" FontStyle="Italic" FontSize="12" Margin="0,0,0,4"
                                                   Visibility="{Binding HasVi, Converter={StaticResource BoolToVis}}"/>
                                        <!-- English — chế độ XEM (read-only) -->
                                        <TextBlock Text="{Binding EnText}" TextWrapping="Wrap"
                                                   Foreground="#1C1C1E" FontSize="14"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                                        <!-- English — chế độ SỬA -->
                                        <TextBox Text="{Binding EnText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 BorderBrush="#C7C7CC" BorderThickness="1" Background="White" Padding="4"
                                                 Foreground="#1C1C1E" FontSize="14"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <!-- Nút chế độ XEM -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <Button Content="Dịch lại" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                        Click="TranslateAgain_Click"
                                                        Visibility="{Binding HasVi, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Edit" FontSize="11" Padding="8,2" Margin="0,0,6,0" Click="Edit_Click"/>
                                                <Button Content="Xoá" FontSize="11" Padding="8,2" Click="DeleteEntry_Click"/>
                                            </StackPanel>
                                            <!-- Nút chế độ SỬA -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <Button Content="Lưu" FontSize="11" Padding="10,2" Margin="0,0,6,0"
                                                        FontWeight="SemiBold" Click="SaveEdit_Click"/>
                                                <Button Content="Huỷ" FontSize="11" Padding="8,2" Click="CancelEdit_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Templates -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
            <TextBlock Text="Mẫu:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <ComboBox x:Name="TemplateCombo" Width="240" DisplayMemberPath="Title" VerticalAlignment="Center"/>
            <Button Content="Chèn" Padding="10,3" Margin="6,0,0,0" Click="InsertTemplate_Click"/>
            <Button Content="Lưu việc đang nhập thành mẫu" Padding="10,3" Margin="12,0,0,0" Click="SaveTemplate_Click"/>
        </StackPanel>

        <!-- Input -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Height="58" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Padding="6"
                     ToolTip="Nhập đầu việc bằng tiếng Việt, rồi bấm Dịch &amp; thêm"/>
            <Button x:Name="AddBtn" Grid.Column="1" Content="Dịch &amp; thêm" Width="110"
                    Margin="8,0,0,0" FontWeight="SemiBold" Click="AddBtn_Click"/>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,8,0,0" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#34C759" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="Sẵn sàng" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
