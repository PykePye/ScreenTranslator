<Window x:Class="ScreenTranslator.UI.WritingAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bryan's Writting Assistant"
        Height="680"
        Width="620"
        MinHeight="460"
        MinWidth="460"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="18,14" BorderBrush="#D1D1D6" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Bryan's Writting Assistant" FontSize="20" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                <TextBlock Text="Improve your English for natural messages and professional emails" Margin="0,3,0,0" Foreground="#6E6E73" FontSize="12"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Border x:Name="UserBubble" HorizontalAlignment="Right" MaxWidth="470" Padding="12" Background="#D7E6FA" CornerRadius="12,12,2,12">
                                <StackPanel>
                                    <TextBlock Text="Bryan" FontWeight="SemiBold" Foreground="#24527C" FontSize="12"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1C1C1E"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AssistantBubble" HorizontalAlignment="Left" MaxWidth="500" Padding="12" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="12,12,12,2">
                                <StackPanel>
                                    <StackPanel x:Name="ResultPanel">
                                        <Border Background="#F1FAF3" Padding="9" CornerRadius="7" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Trợ lý - Sửa tối thiểu" FontWeight="SemiBold" Foreground="#248A3D" DockPanel.Dock="Left"/>
                                                    <Button Content="Copy" Tag="{Binding Minimal}" Click="Copy_Click" Padding="6,1" FontSize="10" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="Câu của bạn, chỉ sửa chỗ sai" Foreground="#6E6E73" FontSize="10" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding Minimal}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1C1C1E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F3F8FF" Padding="9" CornerRadius="7" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Trợ lý - Bản tự nhiên" FontWeight="SemiBold" Foreground="#007AFF" DockPanel.Dock="Left"/>
                                                    <Button Content="Copy" Tag="{Binding Casual}" Click="Copy_Click" Padding="6,1" FontSize="10" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Casual}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1C1C1E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F7F5FF" Padding="9" CornerRadius="7">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Trợ lý - Bản Pro" FontWeight="SemiBold" Foreground="#5856D6" DockPanel.Dock="Left"/>
                                                    <Button Content="Copy" Tag="{Binding Professional}" Click="Copy_Click" Padding="6,1" FontSize="10" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Professional}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1C1C1E"/>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Foreground="#48484A" FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="[-]" FontWeight="Bold" Foreground="{Binding MarkerBrush}"/>
                                                        <Run Text=" '"/>
                                                        <Run Text="{Binding OriginalFragment}" FontWeight="Bold"/>
                                                        <Run Text="' "/>
                                                        <Run Text="{Binding Description}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Reminders}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF4CE" Padding="8" CornerRadius="5" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#6B4D00" FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ChatId, StringFormat='Chat ID: {0}'}" Margin="0,10,0,0" FontSize="10" Foreground="#8E8E93"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ErrorPanel" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#D70015" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter TargetName="AssistantBubble" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="ResultPanel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Sẵn sàng" Margin="16,0,16,6" FontSize="11" Foreground="#6E6E73"/>

        <Border Grid.Row="3" Background="White" BorderBrush="#D1D1D6" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Gửi cho:" VerticalAlignment="Center" Foreground="#6E6E73" FontSize="12" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AudienceBox" ItemsSource="{Binding Audiences}" DisplayMemberPath="VietnameseLabel"
                              SelectedIndex="0" MinWidth="190" Padding="6,3"
                              ToolTip="Chọn người nhận để trợ lý chỉnh đúng mức trang trọng."/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0">
                    <TextBox x:Name="InputBox" MinHeight="72" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="9" KeyDown="InputBox_KeyDown"
                             ToolTip="Paste an English message or email. Press Ctrl+Enter to send."/>
                    <TextBlock Text="Please enter text here..." Margin="12,11,12,11" Foreground="#8E8E93" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="SendButton" Grid.Row="1" Grid.Column="1" Content="SEND" Margin="10,0,0,0" Padding="16,9" VerticalAlignment="Bottom"
                        Click="Send_Click" Background="#007AFF" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
