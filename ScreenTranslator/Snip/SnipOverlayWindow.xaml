<Window x:Class="ScreenTranslator.Snip.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross">
    <Grid x:Name="RootGrid">
        <!-- Lớp phủ tối, chừa trống vùng đang chọn. -->
        <Path x:Name="MaskPath" Fill="#80000000" IsHitTestVisible="False"/>

        <!-- Nhận thao tác chọn vùng, kéo và thay đổi kích thước. -->
        <Canvas x:Name="InputCanvas" Background="Transparent"/>

        <!-- Khung xem trước và thanh xác nhận nằm trên lớp nhận chuột. -->
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF4FC3F7"
                       StrokeThickness="2"
                       Fill="Transparent"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

            <Rectangle x:Name="TopLeftHandle" Width="10" Height="10" Fill="#FF4FC3F7"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
            <Rectangle x:Name="TopRightHandle" Width="10" Height="10" Fill="#FF4FC3F7"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
            <Rectangle x:Name="BottomLeftHandle" Width="10" Height="10" Fill="#FF4FC3F7"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
            <Rectangle x:Name="BottomRightHandle" Width="10" Height="10" Fill="#FF4FC3F7"
                       IsHitTestVisible="False" Visibility="Collapsed"/>

            <Border x:Name="ConfirmationPanel"
                    Width="90"
                    Height="38"
                    Visibility="Collapsed"
                    Background="#FF1C1C1E"
                    CornerRadius="7"
                    Padding="3">
                <StackPanel Orientation="Horizontal">
                    <Button Width="40" Height="30"
                            Content="✓"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#FF34C759"
                            BorderThickness="0"
                            ToolTip="Dùng vùng đã chọn"
                            Click="Confirm_Click"/>
                    <Button Width="40" Height="30"
                            Margin="4,0,0,0"
                            Content="×"
                            FontSize="20"
                            Foreground="White"
                            Background="#FFFF3B30"
                            BorderThickness="0"
                            ToolTip="Huỷ thao tác quét"
                            Click="Discard_Click"/>
                </StackPanel>
            </Border>
        </Canvas>

        <TextBlock x:Name="HintText"
                   Text="Kéo chuột để chọn vùng cần dịch — Escape để huỷ"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
