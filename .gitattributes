# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Source and project files
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.config    text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.yml       text
*.yaml      text
*.editorconfig text
*.gitattributes text
*.gitignore text

# Windows-only scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Shell scripts must keep LF
*.sh        text eol=lf

# Binary files - never touch, never diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.bmp       binary
*.cur       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.snk       binary
*.db        binary
*.sqlite    binary
*.xlsx      binary
*.docx      binary
